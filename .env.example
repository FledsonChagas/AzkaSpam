# Copy to .env and replace with a long random string (32+ chars).
# Used by rspamd controller (auth) and the filter (Authorization header).
# Generate one: openssl rand -base64 48
RSPAMD_PASSWORD=REPLACE_WITH_LONG_RANDOM_STRING

# Optional override for the IMAP credential encryption key. The recommended
# bootstrap path writes the key to state/azkaspam.secret_key instead.
# Generate one with: docker compose run --rm spamfilter generate-secret-key
AZKASPAM_SECRET_KEY=REPLACE_WITH_FERNET_KEY
